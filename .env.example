# Secret used to sign session cookies and hash passwords. Use a long random string.
AUTH_SECRET="replace-with-a-long-random-secret"

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=""

# Database name to use inside the cluster (optional, defaults to "neura").
MONGODB_DB="neura"

# Google Gemini API key, used to power the conversational cognitive quiz and
# (by default) the Care Assistant chat's generation + retrieval embeddings.
# Get one for free at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Which model generates Care Assistant replies: "gemini" (default) or
# "finetuned" to use the fine-tuned model hosted on Hugging Face — see
# training/README.md. Falls back to Gemini automatically if that's set but
# the endpoint below is unreachable.
ASSISTANT_MODEL_PROVIDER="gemini"

# Base URL of the Hugging Face Space serving the fine-tuned model
# (training/hf_space), e.g. https://your-username-neura-care-assistant.hf.space
# Only needed if ASSISTANT_MODEL_PROVIDER=finetuned.
HF_SPACE_URL=""

# Optional shared secret matching SPACE_TOKEN on the Hugging Face Space, so
# random visitors to its public URL can't use your inference compute.
HF_SPACE_TOKEN=""

# Email for password reset links (SMTP). For Gmail: SMTP_USER is the Gmail
# address and SMTP_PASS is a 16-character App Password (Google Account >
# Security > 2-Step Verification > App passwords) — not your normal password.
# If unset in local development, reset links are printed to the server console.
SMTP_USER=""
SMTP_PASS=""
# Optional overrides (defaults shown): SMTP_HOST="smtp.gmail.com", SMTP_PORT="465"
# EMAIL_FROM="Neura <you@gmail.com>"

# Public URL of the site, used to build links in emails, e.g. https://neura.vercel.app
# On Vercel this falls back to the project's production domain automatically.
APP_URL=""
